#!/bin/sh
# ContextPocket pre-commit hook (v3)
#
# Before each commit:
#   0) locate ContextPocket/ by walking up from the repo root. No pocket yet?
#      print a hint and exit 0 — installing the hook before "bootstrap" is a
#      normal order and must never lock every commit out.
#   1) "context-pocket sync --auto"   — git safety net: auto-record staged files
#      that were missed in recent T-blocks (fixes "agent forgot to log").
#   2) "context-pocket verify --quiet" — health check; block commit on errors,
#      allow warnings.
#
# This file is the reference script. The actual installed hook is generated by
# "context-pocket install-hook" (see lib/hooks.js), which embeds the absolute CLI
# path and is wrapped in managed markers. Both share the same three-step logic
# (tests/hooks.js asserts the generated one).
#
# Install with:  context-pocket install-hook
# Uninstall with: context-pocket uninstall-hook
#
# This reference copy assumes the CLI is reachable via the PATH as
# "context-pocket" (e.g. through an npm link / global install). The generated
# hook instead invokes `node <abs-cli> ...` directly, so it works without any
# global install.

command -v context-pocket >/dev/null 2>&1
if [ $? -eq 0 ]; then
  CLI="context-pocket"
  ARGS=""
else
  # Fallback: resolve relative to this script. Works both from <skill>/scripts/
  # and from a hand-copied .git/hooks/ (git runs hooks at the worktree root).
  HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
  for CAND in "$HOOK_DIR/../bin" "$HOOK_DIR/../../bin" "$HOOK_DIR/../../../bin"; do
    if [ -f "$CAND/context-pocket.js" ] && command -v node >/dev/null 2>&1; then
      CLI="node"
      ARGS="$CAND/context-pocket.js"
      break
    fi
  done
  if [ -z "$CLI" ]; then
    echo "⚠️  context-pocket not found, skipping pre-commit checks"
    exit 0
  fi
fi

# step 0: find the pocket (skip cleanly when this repo is not bootstrapped yet)
POCKET_DIR_NAME="ContextPocket"
PROJECT_DIR=""
DIR=$(pwd)
while [ -n "$DIR" ]; do
  if [ -d "$DIR/$POCKET_DIR_NAME" ]; then
    PROJECT_DIR="$DIR"
    break
  fi
  PARENT=$(dirname "$DIR")
  [ "$PARENT" = "$DIR" ] && break
  DIR="$PARENT"
done

if [ -z "$PROJECT_DIR" ]; then
  echo ""
  echo "⚠️  ContextPocket: no $POCKET_DIR_NAME/ directory here; skipping pre-commit checks."
  echo "    Create one with: context-pocket bootstrap --dir <project-root>"
  echo "    Or drop this hook: context-pocket uninstall-hook"
  exit 0
fi

# step 1: git safety net — auto-fill missed T-blocks
SYNC_OUT=$($CLI $ARGS sync --auto --dir "$PROJECT_DIR" 2>&1)
SYNC_RC=$?
if [ $SYNC_RC -ne 0 ]; then
  echo ""
  echo "❌ ContextPocket sync failed — commit blocked."
  echo "$SYNC_OUT"
  echo "   Override (at your own risk): git commit --no-verify"
  exit 1
fi

# step 2: verify
VERIFY_OUT=$($CLI $ARGS verify --quiet --dir "$PROJECT_DIR" 2>&1)
VERIFY_RC=$?
if [ $VERIFY_RC -ne 0 ]; then
  echo ""
  echo "❌ ContextPocket verify failed — commit blocked."
  echo "   Fix the errors above, or run 'context-pocket uninstall-hook' to disable."
  echo ""
  echo "$VERIFY_OUT"
  exit 1
fi

# surface sync auto-fill info (if any)
if [ -n "$SYNC_OUT" ]; then
  echo "$SYNC_OUT"
fi

exit 0
